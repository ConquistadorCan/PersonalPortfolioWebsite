---
import { SITE_OWNER_RESUME_PDF } from "../config/consts";
---

<section id="resume" class="scroll-mt-20">
  <h2
    class="text-3xl font-bold text-[#DFD0B8] mb-12 border-b border-[#393E46] pb-4 inline-block"
  >
    Resume
  </h2>

  <div
    class="bg-[#393E46] rounded-lg p-8 flex flex-col md:flex-row items-center gap-8 hover:transform hover:-translate-y-1 transition-all duration-300"
  >
    <!-- PDF Icon -->
    <div
      class="flex-shrink-0 w-24 h-24 bg-[#222831] rounded-xl flex items-center justify-center border border-[#948979]/30"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-12 h-12 text-[#948979]"
      >
        <path
          d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
        ></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
    </div>

    <!-- Text -->
    <div class="flex-grow text-center md:text-left">
      <h3 class="text-xl font-bold text-[#DFD0B8] mb-2">Curriculum Vitae</h3>
      <p class="text-[#DFD0B8]/60 text-sm leading-relaxed">
        Download my CV to learn more about my experience, skills, and
        background. Available as a PDF.
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-3 flex-shrink-0">
      <a
        href={SITE_OWNER_RESUME_PDF}
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 border-2 border-[#948979] text-[#DFD0B8] rounded hover:bg-[#948979] hover:text-[#222831] transition-all duration-300 font-medium text-center whitespace-nowrap"
      >
        View PDF
      </a>
      <a
        href={SITE_OWNER_RESUME_PDF}
        download="resume.pdf"
        class="px-6 py-3 bg-[#948979] text-[#222831] rounded hover:bg-[#DFD0B8] transition-all duration-300 font-medium text-center whitespace-nowrap"
      >
        Download CV
      </a>
    </div>
  </div>
</section>
